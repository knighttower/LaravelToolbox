{
    "name": "knighttower/laravel-toolbox",
    "description": "Utilities",
    "version": "2.1.0",
    "type": "project",
    "require": {
        "php": "^8",
        "laravel/framework": "^10|^11|^12",
        "nesbot/carbon": "^3.7.0",
        "react/async": "^4.3",
        "react/promise": "^3.2"
    },
    "authors": [
        {
            "name": "knighttower",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Knighttower\\Toolbox\\": "src"
        },
        "files": [
            "src/Helpers/ToolboxGlobal.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Knighttower\\Toolbox\\Providers\\ToolboxServiceProvider"
            ]
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.1",
        "mockery/mockery": "^1.6"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor\\bin\\pest"
    }
}
